{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gregorian-grimorium/schema/chant.schema.json",
  "title": "Chant",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "incipit", "title", "genre", "text_latin", "source", "review_status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Slug único, derivado del íncipit en minúsculas sin acentos."
    },
    "incipit": { "type": "string" },
    "title": { "type": "string" },
    "genre": {
      "type": "string",
      "enum": [
        "Introitus", "Graduale", "Alleluia", "Tractus", "Offertorium",
        "Communio", "Kyrie", "Gloria", "Credo", "Sanctus", "Agnus Dei",
        "Antiphona", "Responsorium", "Hymnus", "Sequentia", "Other"
      ]
    },
    "mode": {
      "type": ["string", "null"],
      "enum": ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", null],
      "description": "Modo gregoriano, cuando aplica y es conocido."
    },
    "text_latin": { "type": "string" },
    "liturgical_occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["calendar", "celebration"],
        "properties": {
          "calendar": { "type": "string" },
          "celebration": { "type": "string" },
          "rank": { "type": "string" }
        }
      },
      "default": []
    },
    "related_chant_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "edition"],
      "properties": {
        "origin": {
          "type": "string",
          "enum": ["gregobase", "public-domain-scan", "licensed"],
          "description": "De dónde procede el registro. 'licensed' requiere autorización documentada aparte."
        },
        "edition": { "type": "string" },
        "external_id": {
          "type": ["string", "null"],
          "description": "Identificador en la fuente externa (p.ej. id de GregoBase)."
        },
        "printed_pages": {
          "type": "array",
          "items": { "type": "integer" },
          "default": []
        }
      }
    },
    "score_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file"],
        "properties": {
          "file": { "type": "string" },
          "page": { "type": ["integer", "null"] },
          "crop": {
            "type": ["array", "null"],
            "items": { "type": "integer" },
            "minItems": 4,
            "maxItems": 4
          }
        }
      },
      "default": []
    },
    "review_status": {
      "type": "string",
      "enum": ["draft", "needs_review", "verified"]
    }
  }
}
